# Copy to a file outside the repository and pass it with --env-file.
# Only variables referenced by the selected roster are read; nothing is executed.
# Endpoints must be OpenAI-compatible (/v1/models and /v1/chat/completions).
# The target endpoint must support tool calling.
AGENTIC_ATTACKER_MODEL=
AGENTIC_ATTACKER_BASE_URL=
AGENTIC_ATTACKER_API_KEY=
AGENTIC_TARGET_MODEL=
AGENTIC_TARGET_BASE_URL=
AGENTIC_TARGET_API_KEY=
AGENTIC_JUDGE_MODEL=
AGENTIC_JUDGE_BASE_URL=
AGENTIC_JUDGE_API_KEY=
# Used only by roster entries with "provider": "ollama".
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
